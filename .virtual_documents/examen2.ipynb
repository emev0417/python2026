def cinco_multiplos(numero):
#El if revisa si el número es menor o igual a cero
    if numero<=0:
        print("Error el número debe ser mayor a 0")
#El return devuelve un valor de una funcion
        return[]
    lista=[numero *1, numero*2, numero *3, numero * 4, numero * 5]
    return lista
#Aqui llamamos a la función
print(cinco_multiplos(5))


