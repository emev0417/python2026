#Aqui definimos la funcion
def primos_en_range(inicio, fin):
#En el for revisa el inicio y el final del rango
    for num in range(inicio,fin +1):
#El if verfica si el numero es > a 1
        if num> 1:
#Si es verdadero primo es true
            es_primo= True
#Aqui el for verifica desde el numero hasta el inicio hasta el final rango 
            for i in range(2,num):
#Aqui usa el if para el modulo cero
                if num % i ==0:
                    es_primo= False
#El break lo utilizamos para detener el ciclo
                    break 
#Si el primo imprime
            if es_primo:
                print(num)
a=int(input("ingrese el primer numero"))
b= int(input("ingrese el segundo numero"))
primos_en_range(a,b)         





#Aqui usamos def para definir la funcion
def contar_vocales(frase):
#Aqui empieza en ceropara que vaya sumando cada que encuentra una vocal
    contador= 0
#Usamos for para que vaya viendo frase
    for letra in frase:
#Con if revisa si hay vocales
        if letra in "aeiou":
#Si encuentra una vocal la suma al contador
            contador += 1
    return contador
#Aqui usamos la función
texto = input("ingrese una frase:")
print("numero de vocales:", contar_vocales(texto))
        



